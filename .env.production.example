APP_ENV=production
APP_NAME=Python Practice
AUTH_MODE=session
# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=true
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
TRUSTED_HOSTS=practice.example.edu
# Nếu Nginx/Caddy chạy ngoài container và proxy qua Docker bridge, khai báo IP gateway/proxy nội bộ tương ứng.
TRUSTED_PROXY_IPS=127.0.0.1
WORKER_HEARTBEAT_MAX_AGE_SECONDS=30

POSTGRES_DB=python_practice
POSTGRES_USER=python_practice
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://python_practice:URL_ENCODED_PASSWORD@db:5432/python_practice
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Dùng Judge0 riêng trong private network/VPN, không dùng CE công cộng cho production.
JUDGE0_BASE_URL=https://judge0.internal.example.edu
JUDGE0_LANGUAGE_ID=100
JUDGE0_AUTH_TOKEN=REPLACE_WITH_JUDGE0_TOKEN
JUDGE0_AUTH_USER=
JUDGE0_POLL_INTERVAL_SECONDS=0.5
JUDGE0_POLL_TIMEOUT_SECONDS=15
JUDGE0_CPU_TIME_LIMIT_SECONDS=5
JUDGE0_WALL_TIME_LIMIT_SECONDS=10
JUDGE0_MEMORY_LIMIT_KB=256000
JUDGE0_MAX_FILE_SIZE_KB=1024
GRADING_STALE_RUN_TIMEOUT_SECONDS=180
WORKER_CONCURRENCY=4

HINT_MAX_QUOTA=3
HINT_COOLDOWN_SECONDS=120
HINT_REQUEST_EXPIRE_SECONDS=300
HINT_EXECUTION_MODE=worker
HINT_WORKER_CLAIM_TIMEOUT_SECONDS=90
HINT_WORKER_MAX_ATTEMPTS=2
HINT_MAX_EVIDENCE=2
HINT_MAX_RETRIES=2
HINT_ALLOW_HIDDEN_ONLY=false

# Chọn api_demo hoặc colab_qwen; production không cho phép fake.
LLM_MODE=api_demo
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=REPLACE_WITH_LLM_API_KEY
LLM_MODEL_ID=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=15
LLM_MAX_TOKENS=400
COLAB_QWEN_MODEL_ID=Qwen/Qwen2.5-Coder-7B-Instruct
COLAB_QWEN_ENDPOINT_URL=
COLAB_QWEN_API_KEY=
GUARDRAIL_TOKEN_OVERLAP_THRESHOLD=0.75
